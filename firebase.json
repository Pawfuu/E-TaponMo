{
  "hosting": [
    {
      "target": "demo",
      "public": "pitch",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ]
    },
    {
      "site": "sparkpish-eco-mvp",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/",
          "destination": "/pitch/pitch.html"
        }
      ]
    }
  ]
}